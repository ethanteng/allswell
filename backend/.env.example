# Postgres connection string (Render Postgres "Internal Database URL" in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allswell?schema=public"

# Secret used to sign JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Comma-separated emails that get isAdmin on registration (and on seed)
ADMIN_EMAILS="you@example.com"

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS="http://localhost:3001"

# Optional. Regex matching additional allowed origins, for hosts that cannot be
# listed ahead of time — notably Vercel's per-deployment URLs, which carry a
# different hash every build. Leave unset for an exact allowlist only.
# Example: ^https://allswell-[a-z0-9-]+-your-team\.vercel\.app$
CORS_ORIGIN_REGEX=""

PORT=3000

# Anthropic API key. Without it the app falls back to the heuristic analyser and
# labels its output as a placeholder everywhere it appears.
ANTHROPIC_API_KEY=""

# Only needed when the key above is organisation-level rather than
# workspace-scoped: such a key has no workspace of its own, so every request has
# to name the one to bill and scope it to. A workspace-scoped key carries that
# already — leave this empty for one.
ANTHROPIC_WORKSPACE_ID=""
